# ---------- OpenAI (required) ----------
OPENAI_API_KEY=sk-your-key-here
# Optional overrides
# LLM_MODEL=gpt-4o
# JUDGE_MODEL=gpt-4o   # grades answers in moxa-eval-answers (defaults to LLM_MODEL)
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT=60

# ---------- Qdrant (optional) ----------
# Leave QDRANT_URL empty to use the embedded on-disk Qdrant at QDRANT_PATH (default ./.qdrant_data)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_PATH=.qdrant_data
# RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8
# RERANK_SCORE_THRESHOLD=-5.0
# RERANK_CANDIDATES=5

# ---------- Jira (required for tickets) ----------
JIRA_SERVER=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_PROJECT_KEY=IKCS
# JIRA_TIMEOUT=15

# ---------- LangSmith tracing (optional) ----------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-key-here
LANGSMITH_PROJECT="Moxa SmartDesk AI"
