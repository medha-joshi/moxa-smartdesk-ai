# Moxa sign-in: the pre-registered employees. Copy to .streamlit/secrets.toml (never commit that file).
# Each entry is keyed by the employee's email (used to sign in) and stores a hash of their password,
# never the password itself. Generate a hash with:  uv run moxa-hash-password

[users."medha_j@yahoo.com"]
name = "Medha"
password_hash = "scrypt$418e4dac47cc1ee7902c5df8560c35b9$2044a20d08ec3f2631da9e285cb8015fbd3365351f3b2b67bbc4c69a0d240558e4a3bff74449fa6a6cd28b1f269b3607466b7e305ec8cd1e088aa33d0582ede4"

# Optional: pre-fill the sign-in form, e.g. for a demo. Leave this out in production.
# [sign_in_defaults]
# email = "medha_j@yahoo.com"
# password = "..."
